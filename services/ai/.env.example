# services/ai — the only component that talks to a model provider.
#
# AI_PROVIDER selects which one. Both paths return a structured object the core application
# validates against the schema it generated; only the mechanism that constrains the model differs.

# --- Hosted (default) ---------------------------------------------------------------
# Forced tool call with a strict schema.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Local, via llama.cpp -----------------------------------------------------------
# No clinical content leaves the machine, which is the strongest available answer to the DPDP
# cross-border question. The shape is guaranteed by llama.cpp's constrained decoding: the JSON
# Schema is compiled to a grammar, so a non-conforming token cannot be sampled.
#
# Start the server (not llama-cli — the service needs its OpenAI-compatible HTTP API):
#
#   set HIP_VISIBLE_DEVICES=0
#   set GGML_VULKAN_UNIFIED_MEMORY=1
#   set ROCBLAS_USE_HIPBLASLT=1
#   llama-server.exe -m <model>.gguf --host 127.0.0.1 --port 8080 ^
#     -ngl 99 --no-mmap -c 16384 --sleep-idle-seconds 300 --flash-attn on -b 512 -ub 64 -t 4 -tb 12 -ctk q8_0 -ctv q8_0
#
# A larger -c than 8192 is worth it here: the prompt carries the whole case plus the permitted
# condition list, and the service warns when the two together will not fit.
#
# AI_PROVIDER=llamacpp
# LLAMA_SERVER_URL=http://127.0.0.1:8080
# LOCAL_MODEL_NAME=qwen3-27b-q4_k_m
# LOCAL_MODEL_CONTEXT=16384
# LOCAL_MODEL_MAX_TOKENS=2048

# Model weights and KV cache unload after five idle minutes, then reload on an AI task.
# /health and /props do not wake the model. -1 explicitly disables sleep; valid range is 1..86400.
LOCAL_MODEL_IDLE_SECONDS=300

# --- Shared -------------------------------------------------------------------------
AI_SERVICE_TOKEN=
DATABASE_URL=postgres://gi_compass_app@127.0.0.1:5432/gi_compass

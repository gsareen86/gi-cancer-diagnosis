# GI Compass — local development. Never commit a real value for any of these.
#
#   cp .env.example .env
#
# Put .env in THIS directory, the repository root. Everything reads it from here: the web app
# walks up from apps/web to find it, and the migrate and seed scripts load it directly. A .env
# inside apps/web also works and takes precedence; real environment variables beat both, so a
# deployment that sets them is never overridden by a file left in a checkout.
#
# The web app validates this at startup and refuses to boot if anything required is missing,
# naming what it is. It will not start half-configured.
#
# Production must place the database and object storage in an India cloud region
# (AWS ap-south-1, Azure Central India, GCP asia-south1) to keep DPDP cross-border
# transfer obligations simple. See design.md § Context.

# --- Database ---------------------------------------------------------------------
# The application connects as gi_compass_app, which has INSERT and SELECT but NOT
# UPDATE or DELETE on audit_log_entries. Migrations run as the schema owner instead.
DATABASE_URL=postgres://gi_compass_app@127.0.0.1:5432/gi_compass
MIGRATION_DATABASE_URL=postgres://postgres@127.0.0.1:5432/gi_compass

# --- Sessions and field-level encryption ------------------------------------------
# 32-byte base64 values. Rotate the encryption key only with a re-encryption plan:
# direct identifiers in the *_enc columns are unreadable without the key that wrote them.
SESSION_SECRET=
FIELD_ENCRYPTION_KEY=

# --- Object storage (uploaded reports) --------------------------------------------
# Encrypted at rest, never public, accessed only through signed URLs of <= 15 minutes.
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_BUCKET=gi-compass-documents
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- AI service --------------------------------------------------------------------
# The core app never holds the model provider key: only services/ai talks to the
# provider, which keeps the egress boundary in one auditable place (design D3).
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TOKEN=
# How long to wait for an assessment, in milliseconds. Default 600000 (ten minutes), matching the
# AI service's own budget. A locally hosted 27B model on an APU generates at around ten tokens a
# second, so a full assessment takes minutes; a shorter limit here aborts work the model is still
# doing correctly and reports it to the doctor as a timeout.
# AI_REQUEST_TIMEOUT_MS=600000

# --- Email --------------------------------------------------------------------------
# Without SMTP_URL nothing is delivered: verification and password-reset messages are printed
# to the server log instead, link included, and their delivery rows are recorded as
# `logged_only` rather than `sent` — the notification table must never claim a patient was told
# something they were not.
#
# `docker compose up` starts Mailpit; the line below reaches it, and its inbox is at
# http://localhost:8025.
SMTP_URL=smtp://127.0.0.1:1025
EMAIL_FROM=no-reply@example.invalid

# --- Local model (optional) ---------------------------------------------------------
# Only `scripts/dev-stack.sh` reads these, to start llama-server for you. The AI service
# itself needs nothing from here: it reads LLAMA_SERVER_URL from services/ai/.env and
# talks to whatever is listening there.
#
# Leave them unset and the stack starts everything else, saying plainly that the model is
# not running. The AI analysis button then reports model_unavailable; no other part of the
# platform depends on it, including emergency escalation.
#
# Windows paths, backslashes and all — the script reads this file as data and never sources it.
LLAMA_SERVER_BIN=
LLAMA_MODEL=

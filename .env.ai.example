# Copy to .env.ai. Never put API keys in NEXT_PUBLIC variables or source code.
AI_PROVIDER=gemini
AI_DATA_MODE=synthetic
AI_OUTPUT_TOKENS=4096
LOCAL_AI_ENDPOINT=http://127.0.0.1:8081
LOCAL_AI_MODEL=gi-compass-local
LOCAL_AI_CONTEXT=16384
# Omit LOCAL_AI_VISION to derive it from the pinned LLAMA_MMPROJ in .env.model.
# LOCAL_AI_VISION=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta
# The standard Gemini API has no verified India-only processing configuration.
GEMINI_VERIFIED_REGION=
GEMINI_REGION_VERIFICATION=
# Future connector: operator-approved HTTPS endpoint with /v1/chat/completions and /tokenize.
COMPATIBLE_ENDPOINT=
COMPATIBLE_MODEL=
COMPATIBLE_API_KEY=
COMPATIBLE_CONTEXT=32768
COMPATIBLE_VISION=false
COMPATIBLE_VERIFIED_REGION=
COMPATIBLE_REGION_VERIFICATION=

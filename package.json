{
  "name": "gi-compass",
  "private": true,
  "version": "0.1.0",
  "description": "AI-assisted GI diagnostic-support platform (India) — doctor-in-the-loop by design",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run test:repo",
    "lint": "eslint .",
    "spec:validate": "npx @fission-ai/openspec validate --all --strict",
    "db:up": "./scripts/dev-postgres.sh",
    "db:migrate": "tsx --env-file-if-exists=.env packages/db/src/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env packages/db/src/seed/index.ts",
    "dev:web": "./scripts/dev-server.sh",
    "e2e:patient": "node --env-file-if-exists=.env e2e/patient-walkthrough.mjs",
    "e2e:doctor": "node e2e/doctor-review.mjs",
    "e2e:api": "node e2e/clinical-api.mjs",
    "test:repo": "vitest run --config vitest.repo.config.ts",
    "user": "tsx --env-file-if-exists=.env apps/web/scripts/manage-users.ts",
    "demo-case": "tsx --tsconfig apps/web/tsconfig.json --env-file-if-exists=.env apps/web/scripts/seed-review-case.ts",
    "dev": "node scripts/dev-stack.mjs up",
    "dev:down": "node scripts/dev-stack.mjs down",
    "dev:status": "node scripts/dev-stack.mjs status"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "playwright": "^1.62.1",
    "vite-node": "^2.1.9",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.11"
  }
}

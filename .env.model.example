# Local paths only. Compute each hash once from the selected trusted file with Get-FileHash.
LLAMA_SERVER_BIN=C:/path/to/llama-server.exe
LLAMA_MODEL=C:/path/to/model.gguf
LLAMA_BINARY_SHA256=
LLAMA_MODEL_SHA256=
# Enable native vision with the projector matching these exact model weights.
LLAMA_MMPROJ=C:/path/to/mmproj.gguf
LLAMA_MMPROJ_SHA256=
LLAMA_CONTEXT=16384
